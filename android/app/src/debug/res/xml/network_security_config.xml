<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug only. Modern Android blocks cleartext by default, which would kill both
  the Metro connection and the TCP link to tools/hardware-emulator.js
  (EXPLAINER/!.md section 3). 10.0.2.2 is how the Android emulator reaches the
  host machine's 127.0.0.1.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.3.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
