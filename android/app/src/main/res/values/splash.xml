<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The launch splash: Android's own start-up screen (the SplashScreen API,
      backported to API 24-30 by androidx.core:core-splashscreen), shown until
      the app draws its first frame. Its background is the app's own
      background - theme.bg in src/ui/theme.ts, the owner's pick - so the
      hand-over to the animated splash changes nothing but the logo.
    -->
    <color name="splash_background">#1a1a1a</color>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.App.Main</item>
    </style>

    <!--
      MainActivity's theme once the splash is gone: AppTheme with the splash
      drawn as the window background (drawable/splash_window.xml), so there is
      no flash while React loads. Only MainActivity - the passkey window
      (CredProviderActivity) keeps plain AppTheme.
    -->
    <style name="Theme.App.Main" parent="AppTheme">
        <item name="android:windowBackground">@drawable/splash_window</item>
    </style>
</resources>
