<?xml version="1.0" encoding="utf-8"?>
<!--
  The adaptive icon's foreground: assets/O.png (copied to
  drawable-nodpi/ic_o_mark.png), tinted white. The layer is 108dp and only the
  central 66dp is guaranteed visible under every launcher mask, so the mark is
  drawn at 36 x 29dp (its own 257:205 aspect), centred - small enough that
  its corners stay inside the 66dp safe circle (at 60 x 48 the round mask cut
  the frame off, 2026-09-25).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="36dp" android:height="29dp" android:gravity="center">
        <bitmap android:src="@drawable/ic_o_mark" android:tint="#FFFFFF" android:filter="true" />
    </item>
</layer-list>
