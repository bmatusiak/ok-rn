<?xml version="1.0" encoding="utf-8"?>
<!--
  The notification (status bar) icon: the O alone.

  Android draws a notification's small icon from its ALPHA only - every
  opaque pixel becomes one flat colour. The launcher icon is a solid black
  circle, so it showed as a plain circle next to the clock. O.png (drawable-
  nodpi/ic_o_mark.png) is black on transparent, and its transparency is the
  O's shape, so it reads as the O. 24dp box, the usual small-icon size, with
  the O at 22 x 18dp (O.png's 257:205).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="24dp" android:height="24dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item android:width="22dp" android:height="18dp" android:gravity="center">
        <bitmap android:src="@drawable/ic_o_mark" android:filter="true" />
    </item>
</layer-list>
