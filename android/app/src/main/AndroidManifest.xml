<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- USB host mode over OTG. required=false so the app still installs on
         phones without host support; the USB screen reports it at runtime. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!-- BLE peripheral mode for the CTAP2 authenticator (EXPLAINER/z.md). -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <!-- Android 12+ split the old BLUETOOTH/BLUETOOTH_ADMIN grants apart. -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <!-- Pre-12, BLE work is gated behind location. -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <!-- Keeps the GATT server alive while a desktop session is open, so the OS
         does not throttle the process mid-authentication. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!--
      Android 11 hides other apps from this one unless they are declared here.
      Without it Linking.canOpenURL() answers FALSE for https on a phone that
      plainly has a browser - the call is not asking "can this be opened", it is
      asking "can you SEE anything that opens it", and the answer is no by
      default. The Tools screen took that at its word and refused to open its
      own links.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>


    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:networkSecurityConfig="@xml/network_security_config"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <!--
        Foreground while the BLE GATT server is up, so a long security-key
        session is not throttled once the screen is off. connectedDevice is
        the Android 14 type for a Bluetooth peripheral; the matching
        FOREGROUND_SERVICE_CONNECTED_DEVICE permission is declared above.
        Started and stopped by NativeFidoGattModule with the server.
      -->
      <service
        android:name=".fido.FidoGattService"
        android:exported="false"
        android:foregroundServiceType="connectedDevice" />

      <!--
        Relaunches the app after the firmware has ended itself. Its own process
        on purpose: killing the main one leaves this alive and in the
        foreground, and only a foreground process may start an activity.
        See RestartActivity for the two simpler approaches that do not work.
      -->
      <activity
        android:name=".RestartActivity"
        android:process=":restart"
        android:theme="@android:style/Theme.Translucent.NoTitleBar"
        android:excludeFromRecents="true"
        android:taskAffinity=""
        android:exported="false" />

      <!--
        ==========  EXPERIMENT: Android Credential Manager  ==========
        One contiguous block on purpose. Deleting it, the credprovider package,
        src/credprovider and the androidx.credentials line in build.gradle
        removes the experiment completely. See REMOVAL.md.

        exported="true" with the BIND_CREDENTIAL_PROVIDER_SERVICE permission is
        the required pair: the service has to be visible for the system to bind
        it, and the permission is what stops anything BUT the system from doing
        so. Exported without it would let any app on the phone drive the key.
      -->
      <service
        android:name=".credprovider.OkCredentialProviderService"
        android:exported="true"
        android:label="OnlyKey"
        android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE"
        tools:targetApi="34">
        <intent-filter>
          <action android:name="android.service.credentials.CredentialProviderService" />
        </intent-filter>
        <meta-data
          android:name="android.credentials.provider"
          android:resource="@xml/provider_config" />
      </service>

      <!--
        Launched by the system PendingIntent once the user picks OnlyKey.

        NOT its own process - unlike RestartActivity above. A second process
        means a second ReactHost and a second okemu writing the same flash.bin,
        which is data loss, not a performance question. taskAffinity and
        excludeFromRecents give the task isolation that is actually wanted here
        without splitting the process.

        Translucent while this is milestone 1 and the activity only reports and
        finishes; it becomes a ReactActivity with AppTheme once it has a UI.
      -->
      <activity
        android:name=".credprovider.CredProviderActivity"
        android:exported="false"
        android:theme="@android:style/Theme.Translucent.NoTitleBar"
        android:excludeFromRecents="true"
        android:taskAffinity=""
        android:launchMode="singleTask" />

      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>

        <!-- Brings the app forward when a matching device is plugged in. -->
        <intent-filter>
            <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
        </intent-filter>
        <meta-data
            android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
            android:resource="@xml/device_filter" />
      </activity>

      <!--
        Hands a staged backup file to another app as a content:// URI.

        A file:// URI has been illegal to share since Android 7 (it throws
        FileUriExposedException), so a backup that is meant to reach Drive has
        to go through a provider. Not exported: only activities this app grants
        per-URI permission to can read it, and that grant lasts as long as the
        share.
      -->
      <provider
        android:name="androidx.core.content.FileProvider"
        android:authorities="${applicationId}.files"
        android:exported="false"
        android:grantUriPermissions="true">
        <meta-data
          android:name="android.support.FILE_PROVIDER_PATHS"
          android:resource="@xml/shared_files" />
      </provider>
    </application>
</manifest>
