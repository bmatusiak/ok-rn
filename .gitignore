# ---- Node ----
node_modules/
npm-debug.log*
yarn-error.log
yarn-debug.log*
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# ---- Metro / RN ----
.metro-health-check*
*.jsbundle
/coverage
# Codegen output (regenerated by the RN gradle plugin on every build)
android/app/build/generated/
**/generated/source/codegen/

# ---- Android ----
build/
.gradle/
.cxx/
local.properties
*.iml
*.hprof
.kotlin/
android/app/release/
android/app/debug/
# Keystores: debug.keystore is committed on purpose, real signing keys are not
*.keystore
*.jks
!android/app/debug.keystore
# Signing credentials - never commit
android/keystore.properties
# Everything apk-signer generates: compiled classes, the provisioned
# emulated device (flash.bin HOLDS THE SIGNING KEY), certificates and the
# build lock. One directory rather than a pattern per artifact, so nothing
# added later can escape by being a name nobody listed.
apk-signer/.local/
android/app/google-services.json

# ---- IDE / OS ----
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ---- Env / secrets ----
.env
.env.*
!.env.example

# ---- Project-local ----
# Local hardware-emulator captures & scratch logs
tools/*.log
*.pcap

# ---- okemu (firmware-on-Android) ----
# Regenerated from the sibling checkouts by scripts/stage.js on every build.
android/okemu/.stage/

# A pinned release's sources, unpacked from git's object database by
# OKEMU_VERSION and cached by commit. Reproducible from ok-versions.json.
android/okemu/.stage-src/
android/okemu/.cxx-probe/
android/okemu/sources.cmake

# Written by android/okemu/scripts/stage.js - describes the staged firmware.
src/generated/

# Metro's own log, written beside the project when it is started by hand.
metro.log

# The last suite verdict, written by tools/e2e.js so tools/matrix.js can read
# counts it cannot get from an inherited stdout.
tools/.last-e2e.json

# Built artifacts. A 49MB apk does not belong in git history - it is
# attached to a GitHub release instead, where it can be replaced.
/dist/
